package com.mycompany.mavenproject3;   
class Edible {
    static class Fruit {

        static void fruitDetails() {
            System.out.println("Fruits are sweet and nutritious.");
        }

        void fruitPackaging() {
            System.out.println("Fruits are packed in boxes.");
        }
    }
    static class Vegetable {

        static void vegetableDetails() {
            System.out.println("Vegetables are rich in vitamins.");
        }

        void vegetablePackaging() {
            System.out.println("Vegetables are packed in bags.");
        }
    }

    public static void main(String[] args) {

        Fruit.fruitDetails();
        Vegetable.vegetableDetails();

        Fruit f = new Fruit();
        Vegetable v = new Vegetable();

        f.fruitPackaging();
        v.vegetablePackaging();
    }
}
